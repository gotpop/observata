{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "observata/section-card-and-graphic",
	"title": "Section Card and Graphic",
	"category": "theme",
	"description": "A single-column section with an inline SVG sphere graphic and an editable card-geo-list.",
	"supports": {
		"html": false
	},
	"attributes": {
		"graphicSphere": {
			"type": "string",
			"default": "graphics/spheres/sphere-globe-tilted"
		},
		"graphicPosition": {
			"type": "string",
			"default": "left"
		},
		"sectionBgColour": {
			"type": "string",
			"default": "white",
			"enum": ["white", "grey", "gradient"]
		}
	},
	"render": "file:render.php",
	"editorScript": "file:../../build/index.js",
	"editorStyle": "file:../../build/index.css",
	"viewStyle": [
		"file:section-card-and-graphic.css",
		"file:../card-geo-list/card-geo-list.css"
	],
	"example": {
		"attributes": {
			"graphicSphere": "graphics/spheres/sphere-globe-tilted",
			"graphicPosition": "left"
		}
	}
}
