{% if breadcrumbs %}
	<section-breadcrumbs class="section-breadcrumbs">
		<nav class="breadcrumbs" aria-label="Breadcrumb">
			{% for crumb in breadcrumbs %}
				{% if crumb.url %}
					<a class="body-sm link-anchor" href="{{ crumb.url|esc_url }}">
						{% if loop.first %}
							{% include 'icons/lucide/house.twig' %}
						{% endif %}
						<span class="body-sm breadcrumb">{{ crumb.label|strip_html }}</span>
					</a>
				{% else %}
					<span class="body-sm breadcrumb">{{ crumb.label|strip_html }}</span>
				{% endif %}
			{% endfor %}
		</nav>
	</section-breadcrumbs>
{% endif %}
