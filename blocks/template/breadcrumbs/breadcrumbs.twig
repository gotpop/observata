{% if breadcrumbs %}
	<section-breadcrumbs class="section-breadcrumbs">
		<nav class="breadcrumbs" aria-label="Breadcrumb">
			{% for crumb in breadcrumbs %}
				{% if crumb.url %}
					<a class="breadcrumb-anchor" href="{{ crumb.url|esc_url }}">
						<span class="breadcrumb">
							{% if loop.first %}
								{% include 'icons/lucide/house.twig' %}
							{% endif %}
							<span class="body-sm">{{ crumb.label|strip_html }}</span>
						</span>
					</a>
				{% else %}
					<span class="breadcrumb">
						<span class="body-sm">{{ crumb.label|strip_html }}</span>
					</span>
				{% endif %}
			{% endfor %}
		</nav>
	</section-breadcrumbs>
{% endif %}
